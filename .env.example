# Copie para .env e preencha. O .env de verdade nunca vai para o repositório.

# ---------------------------------------------------------------- Banco de dados
POSTGRES_USER=farol
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=farol
# Usada pela API, pelo worker e pelas migrações (dentro do Docker o host é "postgres")
DATABASE_URL=postgresql+psycopg://farol:troque-esta-senha@postgres:5432/farol
# Banco de teste (serviço "postgres-teste", perfil "teste"; porta só em 127.0.0.1:5433)
DATABASE_URL_TESTE=postgresql+psycopg://farol:farol@127.0.0.1:5433/farol_teste
# Portas dos bancos no seu computador (sempre em 127.0.0.1). Troque se já houver um PostgreSQL
# local usando 5432 ou 5433; nesse caso, ajuste também a porta em DATABASE_URL_TESTE.
# PORTA_POSTGRES=5432
# PORTA_POSTGRES_TESTE=5433

# ---------------------------------------------------------------- API
# Origens do frontend aceitas pelo CORS, separadas por vírgula
CORS_ORIGENS=http://localhost:5173
# Documentação interativa (/docs e /redoc): só em desenvolvimento
API_DOCS_HABILITADA=true

# ---------------------------------------------------------------- Coleta (worker)
# Contato que vai no User-Agent da coleta (URL ou e-mail). TROQUE pelo seu: com este valor de
# exemplo o worker se recusa a coletar. A Wikipédia pede um contato que a identifique: prefira o
# link do repositório do projeto. O worker coleta logo ao subir se a última tentativa tiver mais
# de LIMITE_HORAS_PARTIDA horas.
CONTATO_COLETA=https://github.com/seu-usuario
# Pausa, em segundos, entre requisições ao gov.br
PAUSA_SEGUNDOS=2
# Ao iniciar, o worker coleta logo se a última tentativa for mais antiga que isto
LIMITE_HORAS_PARTIDA=20

# Pasta com os dados de seed (postos e territórios). Local: ../dados (padrão); no Docker: /app/dados
# DIRETORIO_DADOS=../dados

# ---------------------------------------------------------------- Classificador de alertas (LLM)
# Formato "provedor:modelo". Para o Ollama local: ollama:<modelo>
LLM_CLASSIFICADOR=google_genai:gemini-3.6-flash
GOOGLE_API_KEY=
# Ollama rodando direto na máquina, visto de dentro dos containers
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------- Tradutor de vistos (LLM)
# Formato "provedor:modelo". Vazio = o mesmo modelo de LLM_CLASSIFICADOR
LLM_TRADUTOR=

# ---------------------------------------------------------------- Chat de dúvidas de viagem (LLM)
# O chat só liga por decisão explícita (false = desligado). Em produção, ligue só com os limites
# abaixo maiores que zero.
CHAT_HABILITADO=false
# Formato "provedor:modelo". Vazio = o mesmo modelo de LLM_CLASSIFICADOR (não isola a cota:
# prefira definir um modelo próprio). LLM_CHAT_ALTERNATIVO é o plano B se o principal falhar.
LLM_CHAT=
LLM_CHAT_ALTERNATIVO=
# Chave própria do chat (projeto Google separado, para a cota do chat não afetar a coleta).
# Obrigatória com CHAT_HABILITADO=true (o chat nunca usa GOOGLE_API_KEY, que é da coleta):
# em produção a partida falha sem ela; em desenvolvimento o chat fica indisponível
GOOGLE_API_KEY_CHAT=
# Embeddings (vetores dos trechos dos alertas); mudar o modelo ou as dimensões pede `reindexar`
EMBEDDINGS_MODELO=google_genai:gemini-embedding-001
EMBEDDINGS_DIMENSOES=768
# Limites de uso: perguntas por hora por IP (memória) e teto de perguntas por dia (banco)
CHAT_LIMITE_POR_HORA_POR_IP=20
CHAT_LIMITE_POR_DIA=500
# Prazo de uma pergunta (s), tamanho máximo da pergunta, mensagens de histórico aceitas e trechos
# de alertas consultados por pergunta
CHAT_TEMPO_MAXIMO_SEGUNDOS=20
CHAT_PERGUNTA_MAX_CARACTERES=500
CHAT_HISTORICO_MENSAGENS=6
CHAT_TRECHOS_POR_PERGUNTA=4
# Intervalo (min) do varredor que indexa alertas novos no worker
INDEXACAO_INTERVALO_MINUTOS=5

# ---------------------------------------------------------------- Frontend
# Endereço da API visto pelo navegador. Em produção é variável de ambiente do projeto na Vercel
# (https://<subdominio>.duckdns.org, sem barra no fim), lida na hora do build
VITE_API_URL=http://localhost:8000

# ================================================================ PRODUÇÃO (só no servidor)
# Estas variáveis valem para o docker-compose.prod.yml (veja docs/deploy.md). Em desenvolvimento
# elas não são necessárias: os padrões abaixo já servem.

# Liga as exigências de partida: CORS https, PROXY_CONFIAVEL e COLETAS_AUTOMATICAS definidos
# (o compose de produção já define AMBIENTE e PROXY_CONFIAVEL, este com o IP fixo do Caddy:
# PROXY_CONFIAVEL=172.30.0.2/32, redes ou IPs em CIDR separados por vírgula)
# AMBIENTE=producao
# Domínio público da API (o Caddy emite o certificado para ele), ex.: farol-api.duckdns.org
# DOMINIO=
# Liga as coletas agendadas e as da partida do worker. Fora de produção, indefinida = desligadas;
# em produção é obrigatória (true ou false). Os comandos `coletar ...` funcionam sempre.
COLETAS_AUTOMATICAS=false
# CORS em produção: só origens https:// (o endereço da Vercel), separadas por vírgula
# CORS_ORIGENS=https://farol-atlas.vercel.app
# Limite de pedidos por IP (média por minuto e rajada). 0 em LIMITE_PEDIDOS_POR_MINUTO desliga.
# LIMITE_PEDIDOS_POR_MINUTO=120
# LIMITE_RAJADA=40
# Cache das respostas de leitura: validade máxima (s), intervalo de consulta da versão dos dados
# (s, também o atraso máximo para uma coleta nova aparecer) e max-age enviado ao navegador (s).
# CACHE_TTL_SEGUNDOS=300
# CACHE_VERSAO_SEGUNDOS=15
# CACHE_MAX_AGE_NAVEGADOR_SEGUNDOS=60
# Pasta do log rotativo do worker (o compose de produção usa /app/logs, num volume)
# DIRETORIO_LOGS=
