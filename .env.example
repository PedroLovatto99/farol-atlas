# Copie para .env e preencha. O .env de verdade nunca vai para o repositório.

# ---------------------------------------------------------------- Banco de dados
POSTGRES_USER=farol
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=farol
# Usada pela API, pelo worker e pelas migrações (dentro do Docker o host é "postgres")
DATABASE_URL=postgresql+psycopg://farol:troque-esta-senha@postgres:5432/farol
# Banco de teste (serviço "postgres-teste", perfil "teste"; porta só em 127.0.0.1:5433)
DATABASE_URL_TESTE=postgresql+psycopg://farol:farol@127.0.0.1:5433/farol_teste
# Portas dos bancos no seu computador (sempre em 127.0.0.1). Troque se já houver um PostgreSQL
# local usando 5432 ou 5433; nesse caso, ajuste também a porta em DATABASE_URL_TESTE.
# PORTA_POSTGRES=5432
# PORTA_POSTGRES_TESTE=5433

# ---------------------------------------------------------------- API
# Origens do frontend aceitas pelo CORS, separadas por vírgula
CORS_ORIGENS=http://localhost:5173
# Documentação interativa (/docs e /redoc): só em desenvolvimento
API_DOCS_HABILITADA=true

# ---------------------------------------------------------------- Coleta (worker)
# Contato que vai no User-Agent da coleta (URL ou e-mail). TROQUE pelo seu: com este valor de
# exemplo o worker se recusa a coletar. A Wikipédia pede um contato que a identifique: prefira o
# link do repositório do projeto. O worker coleta logo ao subir se a última tentativa tiver mais
# de LIMITE_HORAS_PARTIDA horas.
CONTATO_COLETA=https://github.com/seu-usuario
# Pausa, em segundos, entre requisições ao gov.br
PAUSA_SEGUNDOS=2
# Ao iniciar, o worker coleta logo se a última tentativa for mais antiga que isto
LIMITE_HORAS_PARTIDA=20

# Pasta com os dados de seed (postos e territórios). Local: ../dados (padrão); no Docker: /app/dados
# DIRETORIO_DADOS=../dados

# ---------------------------------------------------------------- Classificador de alertas (LLM)
# Formato "provedor:modelo". Para o Ollama local: ollama:<modelo>
LLM_CLASSIFICADOR=google_genai:gemini-3.6-flash
GOOGLE_API_KEY=
# Ollama rodando direto na máquina, visto de dentro dos containers
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------- Tradutor de vistos (LLM)
# Formato "provedor:modelo". Vazio = o mesmo modelo de LLM_CLASSIFICADOR
LLM_TRADUTOR=

# ---------------------------------------------------------------- Frontend
# Endereço da API visto pelo navegador
VITE_API_URL=http://localhost:8000
