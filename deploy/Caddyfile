# Proxy reverso de produção do Farol Atlas (Caddy 2).
#
# DOMINIO vem do .env do servidor (ex.: farol-api.duckdns.org). Com um nome público e as portas
# 80 e 443 abertas, o Caddy obtém e renova o certificado (Let's Encrypt) sozinho; os certificados
# ficam no volume caddy-dados e não se perdem entre deploys.

{
	# Só HTTP/1.1 e HTTP/2: a UDP 443 (HTTP/3) não é publicada
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 10s
			# acima dos 20 s do chat: a resposta em fluxo termina antes de o Caddy desistir
			write 30s
			idle 2m
		}
	}
}

# O caminho até a API, igual para todas as rotas. Os argumentos do `import` viram uma linha a mais
# no bloco (o chat passa `flush_interval -1`); sem argumentos, não acrescentam nada.
(api) {
	reverse_proxy api:8000 {
		# O visitante nunca escolhe o próprio IP: o que ele mandar em X-Forwarded-For é
		# descartado e o Caddy escreve só o endereço que viu na conexão
		header_up X-Forwarded-For {remote_host}
		header_up -X-Real-IP

		# Verificação ativa: a cada 5 s, com 2 s de limite. Um passe basta para voltar a usar a API
		# (um reinício no deploy não deixa o Caddy esperando 30 s) e duas falhas seguidas a tiram
		# de cena (uma resposta lenta isolada não derruba o site).
		health_uri /api/v1/saude
		health_interval 5s
		health_timeout 2s
		health_passes 1
		health_fails 2

		# Se a API estiver fora (reinício, deploy), o Caddy segura o pedido e tenta de novo a cada
		# 250 ms por até 10 s, em vez de devolver 503 na hora. Passou disso, devolve 503.
		lb_try_duration 10s
		lb_try_interval 250ms

		{args[:]}
	}
}

{$DOMINIO} {
	header {
		# Sem includeSubDomains nem preload: o domínio é um subdomínio do DuckDNS
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# A API só devolve JSON: nada a carregar, nada a embutir
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# A pergunta do chat, a única escrita da API: corpo de até 16 KB (pergunta de 500 caracteres e
	# 6 mensagens de histórico, com folga) e resposta em fluxo de eventos, repassada evento a
	# evento (flush_interval -1) e sem compressão, que reteria o fluxo
	handle /api/v1/chat {
		request_body {
			max_size 16KB
		}
		import api flush_interval -1
	}

	# Todo o resto só tem GET: um corpo de pedido nunca precisa passar de 1 KB
	handle {
		encode zstd gzip
		request_body {
			max_size 1KB
		}
		import api
	}
}
